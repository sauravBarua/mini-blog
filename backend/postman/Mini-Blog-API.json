{
  "info": {
    "name": "Mini Blog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Phase 1 - Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Phase 2 - Health DB",
      "request": { "method": "GET", "url": "{{baseUrl}}/health/db" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('database is up', () => pm.expect(pm.response.json().database).to.eql('up'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Phase 3 - Unknown route (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/nope" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('NOT_FOUND code', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Phase 3 - Malformed JSON (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"title\": " },
        "url": "{{baseUrl}}/anything"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('INVALID_JSON code', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_JSON'));"
            ]
          }
        }
      ]
    }
  ]
}
