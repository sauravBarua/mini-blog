{
  "info": {
    "name": "Mini Blog API - Phase 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "password", "value": "Password123!" },
    { "key": "emailA", "value": "" },
    { "key": "emailB", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Register user A (201)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailA}}\",\"name\":\"Author A\",\"password\":\"{{password}}\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now();",
              "pm.collectionVariables.set('emailA', 'a_' + id + '@example.com');",
              "pm.collectionVariables.set('emailB', 'b_' + id + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('201', () => pm.response.to.have.status(201));"]
          }
        }
      ]
    },
    {
      "name": "02 Create draft post (201)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"My first post\",\"content\":\"Hello from Postman\",\"published\":false}"
        },
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const post = pm.response.json().post;",
              "pm.test('draft by Author A', () => { pm.expect(post.published).to.eql(false); pm.expect(post.author.name).to.eql('Author A'); });",
              "pm.collectionVariables.set('postId', post.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create post invalid (400)",
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"title\":\"\",\"content\":\"\"}" },
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 My posts include the draft, without content (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/mine" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('contains the draft', () => pm.expect(body.data.some((p) => p.id === pm.collectionVariables.get('postId'))).to.eql(true));",
              "pm.test('no content in list', () => pm.expect(body.data[0]).to.not.have.property('content'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Public list hides the draft (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts?limit=50" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('draft not listed', () => pm.expect(pm.response.json().data.some((p) => p.id === pm.collectionVariables.get('postId'))).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Owner reads own draft (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('has content', () => pm.expect(pm.response.json().post.content).to.eql('Hello from Postman'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Publish the post (200)",
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\"published\":true}" },
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('published', () => pm.expect(pm.response.json().post.published).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Update title only keeps published (200)",
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\"title\":\"Updated title\"}" },
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const post = pm.response.json().post;",
              "pm.test('title changed, still published', () => { pm.expect(post.title).to.eql('Updated title'); pm.expect(post.published).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Update with empty body (400)",
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "10 Public list shows the post, with meta (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts?limit=50" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('post listed', () => pm.expect(body.data.some((p) => p.id === pm.collectionVariables.get('postId'))).to.eql(true));",
              "pm.test('meta', () => { pm.expect(body.meta.limit).to.eql(50); pm.expect(body.meta.page).to.eql(1); pm.expect(body.meta.total).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Invalid pagination (400)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts?limit=0" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "12 Add comment (201)",
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"content\":\"Nice post!\"}" },
        "url": "{{baseUrl}}/posts/{{postId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const comment = pm.response.json().comment;",
              "pm.test('by Author A', () => pm.expect(comment.author.name).to.eql('Author A'));",
              "pm.collectionVariables.set('commentId', comment.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Add empty comment (400)",
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"content\":\"\"}" },
        "url": "{{baseUrl}}/posts/{{postId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "14 List comments (200)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}/comments" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('one comment', () => { pm.expect(body.data.length).to.eql(1); pm.expect(body.meta.total).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Register user B (201)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailB}}\",\"name\":\"Reader B\",\"password\":\"{{password}}\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('201', () => pm.response.to.have.status(201));"]
          }
        }
      ]
    },
    {
      "name": "16 B edits A's post (403)",
      "request": {
        "method": "PATCH",
        "body": { "mode": "raw", "raw": "{\"title\":\"Hacked\"}" },
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403', () => pm.response.to.have.status(403));",
              "pm.test('FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 B deletes A's post (403)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/{{postId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403', () => pm.response.to.have.status(403));"]
          }
        }
      ]
    },
    {
      "name": "18 B deletes A's comment (403)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/comments/{{commentId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403', () => pm.response.to.have.status(403));"]
          }
        }
      ]
    },
    {
      "name": "19 Login as A (200)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailA}}\",\"password\":\"{{password}}\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "20 A deletes own comment (204)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/comments/{{commentId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "21 A deletes own post (204)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/{{postId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "22 Deleted post is gone (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/{{postId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('POST_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('POST_NOT_FOUND'));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Logout (204)",
      "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "24 Create post while logged out (401)",
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"title\":\"Nope\",\"content\":\"Nope\"}" },
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ]
    }
  ]
}
